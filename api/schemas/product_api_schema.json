{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Products List",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "price", "category", "emoji", "color", "stock", "rating"],
    "properties": {
      "id":          { "type": "string" },
      "name":        { "type": "string" },
      "description": { "type": "string" },
      "price":       { "type": "number" },
      "category":    { "type": "string" },
      "emoji":       { "type": "string" },
      "color":       { "type": "string" },
      "stock":       { "type": "number" },
      "rating":      { "type": "number" }
    },
    "additionalProperties": false
  }
}

