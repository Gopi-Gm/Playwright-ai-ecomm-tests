{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cart Add Response",
  "type": "object",
  "required": ["product", "quantity"],
  "properties": {
    "product": {
      "type": "object",
      "required": ["id", "name", "price"],
      "properties": {
        "id":    { "type": "string" },
        "name":  { "type": "string" },
        "price": { "type": "number" }
      }
    },
    "quantity": { "type": "number" }
  }
}

